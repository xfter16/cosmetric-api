doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title
    style.
      body {
        font-family: system-ui, sans-serif;
        margin: 2rem;
        color: #222;
      }
      h1, h2 {
        margin-top: 0;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        max-width: 900px;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 0.5rem 1rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: #f5f5f5;
      }
      a {
        color: #0066cc;
      }
      .back {
        margin-bottom: 1rem;
      }
      .muted {
        color: #666;
      }
  body
    block content
